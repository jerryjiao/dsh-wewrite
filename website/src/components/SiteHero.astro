---
import Icon from './Icon.astro';
import GithubMark from './GithubMark.astro';
import { INSTALL_CMD, REPO_URL } from '../site-data';

const base = import.meta.env.BASE_URL;
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="brand-row">
          <img
            class="brand-mark"
            src={`${base}mark-1024.png`}
            alt="dsh-wewrite 标识"
            width="40"
            height="40"
          />
          <span class="brand-word">dsh-wewrite</span>
        </div>
        <h1 class="hero-title">
          30+ 篇文章验证的公众号写作管线<br />
          <span class="hero-title-accent">一条命令装进 DSH</span>
        </h1>
        <p class="hero-sub">
          选题、写作、质量门禁、排版、配图、草稿箱，装进你每天在用的 DSH。模型是你的，凭据只落本地，群发永远归你。
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href={REPO_URL}>
            <GithubMark size={16} /> GitHub 仓库 <Icon name="star" size={16} />
          </a>
          <a class="btn btn-outline" href="#quickstart">
            5 分钟上手 <Icon name="arrow-down" size={16} />
          </a>
        </div>
      </div>
      <div>
        <div class="codeblock">
          <div class="codeblock-bar">
            <span class="codeblock-lang"><Icon name="terminal" size={16} /> bash</span>
            <button class="copy-btn" type="button" data-copy={INSTALL_CMD} aria-label="复制安装命令">
              <Icon name="copy" size={16} class="icon-copy" />
              <Icon name="check" size={16} class="icon-check" />
              <span class="copy-status visually-hidden" aria-live="polite"></span>
            </button>
          </div>
          <div class="codeblock-body">
            <div class="cmd"><span class="prompt">$</span> npx @deepseek-ai/dsh plugin --profile web add github:jerryjiao/dsh-wewrite#v0.1.0</div>
            <div class="cmd"><span class="prompt">$</span> npx @deepseek-ai/dsh web</div>
            <div class="cmd-out">→ http://127.0.0.1:3080</div>
          </div>
        </div>
        <p class="hero-prereq">需要 Node ^22.19.0 || &gt;=24.0.0 与 DSH v0.1.x developer preview</p>
      </div>
    </div>
    <p class="hero-meta">v0.1.0 · MIT · 318 个测试 · 无遥测</p>
  </div>
</section>

<style>
  .hero {
    padding-block: 80px;
    background: var(--site-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 8px;
  }

  .brand-word {
    font-family: var(--site-font-mono);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-title {
    font-size: var(--site-text-hero);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  /* Hero 唯一静态 accent：H1 第二行纯色平涂（无渐变无 clip） */
  .hero-title-accent {
    color: var(--site-accent);
  }

  .hero-sub {
    font-size: 16px;
    line-height: 1.7;
    color: var(--site-fg-secondary);
    margin-bottom: 32px;
    max-width: 36ch;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-prereq {
    margin-top: 12px;
    font-family: var(--site-font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-fg-secondary);
  }

  .hero-meta {
    margin-top: 64px;
    font-family: var(--site-font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-fg-secondary);
  }

  @media (max-width: 899px) {
    .hero {
      padding-block: 48px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-meta {
      margin-top: 32px;
    }
  }
</style>
