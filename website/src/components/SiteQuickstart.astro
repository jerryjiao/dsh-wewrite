---
import Icon from './Icon.astro';
import { INSTALL_CMD } from '../site-data';

// 竖排三行（桌面与移动同构）；步骤号是流程性编号（divider 时间线语义），非装饰编号
const steps = [
  {
    num: '01',
    title: '装插件',
    body: '一条命令装进 DSH。仓库直接提交了预构建产物，不需要在 pnpm 侧加任何 allowBuilds 信任声明，装完即用。',
  },
  {
    num: '02',
    title: '配凭据',
    body: '工作台设置页填公众号 AppID / AppSecret，点连接测试。模型不用另配——文本生成直接用 DSH 里已有的模型配置。图片供应商 API Key 可选，不配则文章无图推进，不阻塞发布。',
  },
  {
    num: '03',
    title: '出第一篇',
    body: '选题面板挑一条热榜，或直接输入主题。管线跑完选题、大纲、成稿、门禁、渲染、配图六步，在编辑器里改稿——右侧微信预览与最终推送产物字节一致。确认后点推草稿箱，到公众平台后台图文素材里查看。群发请你在后台自己点。',
  },
];
---

<section id="quickstart" class="section">
  <div class="container">
    <h2 class="section-title">5 分钟上手</h2>
    <ol class="qs-list">
      {
        steps.map((step) => (
          <li class="qs-row">
            <div class="qs-num">{step.num}</div>
            <div class="qs-body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.num === '01' && (
                <div class="inline-cmd">
                  <code>{INSTALL_CMD}</code>
                  <button class="copy-btn" type="button" data-copy={INSTALL_CMD} aria-label="复制安装命令">
                    <Icon name="copy" size={16} class="icon-copy" />
                    <Icon name="check" size={16} class="icon-check" />
                    <span class="copy-status visually-hidden" aria-live="polite" />
                  </button>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .qs-list {
    margin-top: 32px;
    list-style: none;
    padding: 0;
  }

  .qs-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 24px;
    padding-block: 24px;
  }

  .qs-row + .qs-row {
    border-top: 1px solid var(--site-divider);
  }

  .qs-num {
    font-family: var(--site-font-mono);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--site-fg-secondary);
  }

  .qs-body h3 {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .qs-body p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--site-fg-secondary);
    max-width: 75ch;
  }

  @media (max-width: 899px) {
    .qs-row {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }

    .qs-num {
      font-size: 24px;
    }
  }
</style>
