---
import Icon from './Icon.astro';
import { INSTALL_CMD } from '../site-data';

const base = import.meta.env.BASE_URL;

// 竖排三行（桌面与移动同构）；步骤号是流程性编号（divider 时间线语义），非装饰编号
// 截图均来自 v0.2.0 真机运行（DSH Web 实拍）
const steps = [
  {
    num: '01',
    title: '装插件',
    body: '一条命令装进 DSH。仓库直接提交了预构建产物，不需要在 pnpm 侧加任何 allowBuilds 信任声明，装完即用。',
    shot: 'screenshots/01-workbench.png',
    shotAlt:
      '写作工作区界面：左栏文章列表（搜索、状态筛选、门禁标记、新文章入口），主区编辑器默认载入最近一篇',
    shotCaption: '装完启动 dsh web，会话视图环里出现「wewrite 工作台」tab；侧边栏底部也有「打开写作台」入口，可跳过会话一键全屏进入。',
  },
  {
    num: '02',
    title: '配凭据',
    body: '工作台设置页填公众号 AppID / AppSecret，点连接测试。模型不用另配——文本生成直接用 DSH 里已有的模型配置。图片供应商 API Key 可选，不配则文章无图推进，不阻塞发布。',
    shot: 'screenshots/07-settings.png',
    shotAlt:
      '设置界面：公众号、模型服务、图片供应商、API 代理、发布纪律分组配置，凭据输入框回显掩码',
    shotCaption: '设置页按分组配置；AppSecret 保存后只回显掩码，连接测试在同一页。',
  },
  {
    num: '03',
    title: '出第一篇',
    body: '选题面板挑一条热榜——点开先看 AI 速览（抓原文后的中文要点，抓不到则给标题解读），合适就「写这个」；或直接输入主题。管线跑完选题、大纲、成稿、门禁、渲染、配图六步，在编辑器里改稿——选中一段点「AI 改写」可局部重写（可撤销），右侧微信预览与最终推送产物字节一致。确认后点推草稿箱，到公众平台后台图文素材里查看。群发请你在后台自己点。',
    shot: 'screenshots/02-hotspots.png',
    shotAlt: '选题中心界面：热门榜按序号列出多条 Hacker News 条目，每条带来源与「写这个」按钮',
    shotCaption: '选题中心热门榜拉取真实 Hacker News 数据；点开条目出 AI 速览，点「写这个」直接进管线。',
  },
];
---

<section id="quickstart" class="section">
  <div class="container">
    <h2 class="section-title">5 分钟上手</h2>
    <ol class="qs-list">
      {
        steps.map((step) => (
          <li class="qs-row">
            <div class="qs-num">{step.num}</div>
            <div class="qs-body">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.num === '01' && (
                <div class="inline-cmd">
                  <code>{INSTALL_CMD}</code>
                  <button class="copy-btn" type="button" data-copy={INSTALL_CMD} aria-label="复制安装命令">
                    <Icon name="copy" size={16} class="icon-copy" />
                    <Icon name="check" size={16} class="icon-check" />
                    <span class="copy-status visually-hidden" aria-live="polite" />
                  </button>
                </div>
              )}
              <figure class="qs-shot">
                <img
                  src={`${base}${step.shot}`}
                  alt={step.shotAlt}
                  width="1440"
                  height="900"
                  loading="lazy"
                />
                <figcaption>{step.shotCaption}</figcaption>
              </figure>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .qs-list {
    margin-top: 32px;
    list-style: none;
    padding: 0;
  }

  .qs-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 24px;
    padding-block: 24px;
  }

  .qs-row + .qs-row {
    border-top: 1px solid var(--site-divider);
  }

  .qs-num {
    font-family: var(--site-font-mono);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--site-fg-secondary);
  }

  .qs-body h3 {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .qs-body p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--site-fg-secondary);
    max-width: 75ch;
  }

  .qs-shot {
    margin-top: 16px;
    max-width: 720px;
  }

  .qs-shot img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--site-surface);
    border: 1px solid var(--site-border);
    border-radius: 8px;
  }

  .qs-shot figcaption {
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-fg-secondary);
  }

  @media (max-width: 899px) {
    .qs-row {
      grid-template-columns: 56px 1fr;
      gap: 16px;
    }

    .qs-num {
      font-size: 24px;
    }
  }
</style>
